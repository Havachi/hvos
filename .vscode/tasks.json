{
    "version": "2.0.0",
    "tasks": [
		{
		"label": "Launch QEMU",
		"type": "shell",
		"linux": {
			"command": "qemu-system-x86_64 -S -gdb tcp::1234 -boot d -cdrom hvos-boot.iso -m 1G -smp 4 -daemonize"
		}
	},
	{
		"label": "Build HVOS",
		"type": "shell",
		"command": "make",
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"problemMatcher": "$gcc",
		"presentation": {
			"reveal": "silent",
			"panel": "shared",
			"clear": true
		}
	}
]
}