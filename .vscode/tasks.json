{
    "version": "2.0.0",
    "tasks": [
	{
		"label": "Launch QEMU",
		"type": "shell",
		"linux": {
			"command": "make rundbg"
		}
	},
	{
		"label": "Build HVOS",
		"type": "shell",
		"command": "make",
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"problemMatcher": "$gcc",
		"presentation": {
			"reveal": "silent",
			"panel": "shared",
			"clear": true
		}
	},
	{
		"label": "Build hvlibc",
		"type": "shell",
		"command": "make -C ${cwd}/hvlibc",
		"group": {
			"kind": "build",
			"isDefault": true
		},
		"problemMatcher":"$gcc",
		"presentation": {
			"reveal": "silent",
			"panel": "shared",
			"clear": true
		}
	}
]
}